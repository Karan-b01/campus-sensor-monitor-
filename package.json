{
  "name": "campus-sensor-monitoring-api",
  "version": "1.0.0",
  "description": "Event-driven campus sensor ingestion, time-series persistence, and alerting backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/services/worker.ts",
    "simulator": "tsx src/simulator.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test src/lib/readings.test.ts src/domain/alert-rules.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sensors",
    "fastify",
    "redis",
    "timescaledb"
  ],
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
